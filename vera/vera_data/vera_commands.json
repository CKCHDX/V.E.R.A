{
  "version": "1.0.0",
  "description": "VERA command library - defines allowed commands and their help documentation",
  
  "allowed": [
    "ls", "dir", "pwd", "cat", "type", "echo", "whoami", "hostname",
    "uname", "date", "uptime", "df", "free", "ps", "top",
    "ifconfig", "ip", "ping", "nslookup", "dig",
    "git", "python", "python3", "pip", "pip3", "node", "npm"
  ],
  
  "categories": {
    "system_info": {
      "description": "Commands for getting system information",
      "commands": ["uname", "hostname", "whoami", "uptime", "date"]
    },
    "file_operations": {
      "description": "Safe file viewing and navigation commands",
      "commands": ["ls", "dir", "pwd", "cd", "cat", "type"]
    },
    "process_monitoring": {
      "description": "Commands for monitoring system processes",
      "commands": ["ps", "top", "free", "df"]
    },
    "network": {
      "description": "Network diagnostic commands",
      "commands": ["ping", "ifconfig", "ip", "netstat", "nslookup", "dig"]
    },
    "development": {
      "description": "Development and programming tools",
      "commands": ["git", "python", "python3", "pip", "node", "npm"]
    }
  },
  
  "help": {
    "ls": {
      "description": "List directory contents",
      "usage": "ls [options] [path]",
      "examples": ["ls", "ls -la", "ls /home"],
      "safe": true
    },
    "cat": {
      "description": "Display file contents",
      "usage": "cat [file]",
      "examples": ["cat file.txt", "cat /etc/hosts"],
      "safe": true,
      "note": "Read-only operation"
    },
    "pwd": {
      "description": "Print working directory",
      "usage": "pwd",
      "examples": ["pwd"],
      "safe": true
    },
    "uname": {
      "description": "Print system information",
      "usage": "uname [options]",
      "examples": ["uname", "uname -a"],
      "safe": true
    },
    "df": {
      "description": "Report file system disk space usage",
      "usage": "df [options]",
      "examples": ["df -h"],
      "safe": true
    },
    "ps": {
      "description": "Report process status",
      "usage": "ps [options]",
      "examples": ["ps aux", "ps -ef"],
      "safe": true
    },
    "git": {
      "description": "Version control system",
      "usage": "git [command] [options]",
      "examples": ["git status", "git log", "git diff"],
      "safe": true,
      "note": "Only read operations are safe"
    }
  },
  
  "command_timeout": 30,
  "max_output_lines": 1000,
  
  "notes": [
    "All commands are executed with timeout protection",
    "Output is limited to prevent resource exhaustion",
    "Commands are logged for audit purposes",
    "Only safe, read-oriented commands are allowed by default"
  ]
}
